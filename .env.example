# Auth.js. Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID -> Web).
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://www.pgd-velikomlacevo.si/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated poweruser allowlist. Matching is case- and whitespace-insensitive.
# Leaving this empty locks EVERYONE out - it fails closed on purpose.
ALLOWED_EMAILS=

# --- Databases -----------------------------------------------------------------------
# Dev and production are two branches of the same Neon project, NOT two databases you
# keep in sync by hand. A Neon branch is a copy-on-write clone: it starts as the parent's
# data and only stores what you change afterwards.
#
#   production branch -> Vercel "Production" env only. The brigade's real data.
#   dev branch        -> Vercel "Development" + "Preview", and this file locally.
#
# So `vercel env pull` gives you the DEV database, and nothing you run locally
# (`db:seed`, `db:migrate`, the test suite) can reach production data.
#
# DATABASE_URL is the pooled (PgBouncer) endpoint used by the app.
# DATABASE_URL_UNPOOLED is the direct connection, used by drizzle-kit for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The integration suite in tests/db-integration.test.ts CREATES AND DELETES rows, so it
# reads this variable and never DATABASE_URL - leave it unset and the suite skips rather
# than touching whatever DATABASE_URL happens to point at. Point it at the dev branch (or
# a throwaway branch of your own); never at production.
TEST_DATABASE_URL=

# Do NOT set AUTH_URL. With trustHost: true, Auth.js infers it from the request host,
# and a hardcoded wrong value is the most common cause of redirect_uri_mismatch.
