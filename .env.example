# Auth.js. Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID -> Web).
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://www.pgd-velikomlacevo.si/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated poweruser allowlist. Matching is case- and whitespace-insensitive.
# Leaving this empty locks EVERYONE out - it fails closed on purpose.
ALLOWED_EMAILS=

# Provisioned automatically by `vercel integration add neon`.
# DATABASE_URL is the pooled (PgBouncer) endpoint used by the app.
# DATABASE_URL_UNPOOLED is the direct connection, used by drizzle-kit for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Do NOT set AUTH_URL. With trustHost: true, Auth.js infers it from the request host,
# and a hardcoded wrong value is the most common cause of redirect_uri_mismatch.
